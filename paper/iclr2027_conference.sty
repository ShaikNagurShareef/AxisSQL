%%%% ICLR 2027 conference style file (community re-creation).
%%%% Mirrors the layout conventions of the official ICLR template
%%%% (single column, 10pt, Times, "Under review" header). Swap in the
%%%% official iclr2027_conference.sty when it is released.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{iclr2027_conference}[2026/06/19 ICLR 2027 submission style]

\RequirePackage{eso-pic}
\RequirePackage{fancyhdr}
\RequirePackage{natbib}
\RequirePackage{times}

% ----- Submission / final switches (default: under review) -----
\newif\if@iclrfinal\@iclrfinalfalse
\DeclareOption{final}{\@iclrfinaltrue}
\DeclareOption{submission}{\@iclrfinalfalse}
\ProcessOptions\relax

% ----- Page geometry (US letter, ICLR margins) -----
\RequirePackage[letterpaper,top=1in,bottom=1in,left=1.5in,right=1.5in,headheight=14pt]{geometry}

\setlength{\parindent}{0pt}
\setlength{\parskip}{6pt plus 2pt minus 1pt}
\widowpenalty=10000
\clubpenalty=10000

% ----- Header -----
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0pt}
\if@iclrfinal
  \fancyhead[C]{\small Published as a conference paper at ICLR 2027}
\else
  \fancyhead[C]{\small Under review as a conference paper at ICLR 2027}
\fi
\fancyfoot[C]{\small\thepage}

% ----- Title block -----
\renewcommand{\@maketitle}{%
  \newpage
  \null
  \vskip 1em%
  \begin{center}%
    {\LARGE\bfseries \@title \par}%
    \vskip 1.2em%
    {\large \@author \par}%
  \end{center}%
  \vskip 1em%
}

% Authors: \author{Name\\ Affiliation \And Name2\\ Affiliation2}
\newcommand{\And}{\hskip 2em}
\newcommand{\AND}{\\[1ex]}

% ----- Abstract -----
\renewenvironment{abstract}{%
  \centerline{\large\bfseries Abstract}%
  \vspace{0.5em}%
  \begin{quote}%
}{%
  \end{quote}%
  \vspace{0.5em}%
}

% ----- Section fonts (ICLR uses bold, slightly larger) -----
\RequirePackage{titlesec}
\titleformat{\section}{\large\bfseries}{\thesection}{1em}{}
\titleformat{\subsection}{\normalsize\bfseries}{\thesubsection}{1em}{}
\titleformat{\subsubsection}{\normalsize\bfseries}{\thesubsubsection}{1em}{}
\titlespacing*{\section}{0pt}{2.0ex plus 1ex minus .2ex}{1.0ex plus .2ex}
\titlespacing*{\subsection}{0pt}{1.6ex plus 1ex minus .2ex}{0.8ex plus .2ex}

% ----- Bibliography style -----
\renewcommand{\bibsection}{\section*{References}}
\setlength{\bibsep}{2pt plus 0.3ex}

\endinput
